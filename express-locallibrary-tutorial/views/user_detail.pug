extends layout

block content

  h1 User: #{user.name}
  p #{user.date_of_birth_formatted}
  h4 User ID: #{user._id}

  div(style='margin-left:20px;margin-top:20px')

    h2(style='font-size: 1.5rem;') Books
    if user_books.length
      dl
        each book in user_books
          dt
            a(href=book.url) #{book.title}
          dd #{book.summary}
    else
      p This user has no books.
