{
  "name": "todo-react-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "start": "npm run build && node ./bin/www",
    "devstart": "nodemon ./bin/www",
    "serverstart": "concurrently \"npm run build:watch\" \"npm run devstart\" \"start http://127.0.0.1:3000/todo/\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@picocss/pico": "^2.1.1",
    "@vitejs/plugin-react": "5.1.4",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "debug": "^4.4.1",
    "express": "5.2.1",
    "express-validator": "^7.3.1",
    "http-errors": "~2.0.0",
    "luxon": "^3.7.2",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.1",
    "morgan": "^1.10.0",
    "pug": "3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.14.0",
    "typescript": "5.9.3",
    "vite": "^4.3.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  }
}
